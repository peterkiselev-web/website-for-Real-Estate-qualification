{
  "name": "swipe-to-shortlist",
  "version": "1.0.0",
  "description": "Tinder-style buyer qualification funnel for Dubai estate agents.",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "images": "node scripts/generate-images.js",
    "sync": "node scripts/sync-standalone.js",
    "test": "node --test test/*.test.js",
    "pages": "node scripts/build-pages.js",
    "build": "npm run images && npm run sync && npm run pages"
  },
  "keywords": [
    "real-estate",
    "dubai",
    "lead-qualification",
    "swipe"
  ],
  "license": "MIT",
  "private": true
}
